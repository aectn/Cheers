# 依赖
node_modules/
# 注意：package-lock.json 必须提交 —— Cloudflare Workers Builds 会执行 npm ci，
# 缺了这个文件会导致构建失败（本项目无依赖，lock 文件很小）

# Wrangler 构建产物与本地状态
dist/
.wrangler/

# Astro 生成缓存（构建时自动重新生成，无需提交）
.astro/
.dev.vars
.mf metrics

# 环境变量 / 密钥（本项目暂无，但防止误提交）
.env
.env.*
!.env.example

# 系统杂项
.DS_Store
Thumbs.db
desktop.ini

# 日志
*.log
npm-debug.log*
